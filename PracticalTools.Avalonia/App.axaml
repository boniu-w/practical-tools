<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalTools.Desktop.App" RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button"><Setter Property="Padding" Value="16,9" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="36" /></Style>
  </Application.Styles>
</Application>
