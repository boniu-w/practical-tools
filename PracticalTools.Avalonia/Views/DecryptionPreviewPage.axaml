<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalTools.Desktop.Views.DecryptionPreviewPage">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <StackPanel x:Name="Inputs" Spacing="8">
      <TextBlock Text="解密预览" FontSize="22" />
      <TextBlock Text="支持文本、PNG/JPEG、DOCX 正文、XLSX 和 PDF 分页预览；音视频暂未接入。" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <ComboBox x:Name="LibraryKeys" HorizontalAlignment="Stretch" PlaceholderText="选择包含私钥的密钥" />
        <Button Grid.Column="1" Content="刷新密钥" Click="RefreshKeys" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="InputPath" Watermark="加密文件路径" />
        <Button Grid.Column="1" Content="选择文件" Click="PickInput" />
      </Grid>
      <Button x:Name="RunButton" Content="查看加密文件" Click="Run" />
    </StackPanel>
    <Button Grid.Row="1" x:Name="CloseButton" Content="关闭预览 / 取消" Click="ClosePreview" />
    <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap" />
    <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
      <StackPanel x:Name="PdfControls" IsVisible="False" Orientation="Horizontal" Spacing="8">
        <Button x:Name="PreviousPage" Content="上一页" Click="PreviousPdfPage" />
        <TextBlock x:Name="PdfPosition" VerticalAlignment="Center" />
        <Button x:Name="NextPage" Content="下一页" Click="NextPdfPage" />
        <Button x:Name="ZoomOut" Content="缩小" Click="ZoomPdfOut" />
        <TextBlock x:Name="PdfZoom" VerticalAlignment="Center" />
        <Button x:Name="ZoomIn" Content="放大" Click="ZoomPdfIn" />
      </StackPanel>
      <StackPanel x:Name="WorkbookHeader" IsVisible="False" Spacing="6">
        <ComboBox x:Name="SheetSelector" HorizontalAlignment="Stretch" SelectionChanged="SelectSheet" />
        <TextBlock Text="按单元格地址显示原始值；公式仅显示缓存结果，可能过时。日期/百分比等不套用格式，合并单元格不还原布局。" TextWrapping="Wrap" />
      </StackPanel>
      <TextBox Grid.Row="1" x:Name="TextPreview" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" IsVisible="False" />
      <ScrollViewer Grid.Row="1" x:Name="ImageHost" IsVisible="False" HorizontalScrollBarVisibility="Auto"><Image x:Name="ImagePreview" Stretch="Uniform" /></ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
