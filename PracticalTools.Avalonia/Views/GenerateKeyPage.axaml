<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalTools.Desktop.Views.GenerateKeyPage">
  <ScrollViewer>
    <StackPanel x:Name="Form" Margin="32" Spacing="16" MaxWidth="960" HorizontalAlignment="Center">
      <StackPanel Spacing="6">
        <TextBlock Text="生成 GPG 密钥对" Classes="pageTitle" />
        <TextBlock Text="生成 RSA 密钥并自动保存到密钥库；私钥口令用于以后解密或导出。" Classes="muted" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="身份与口令" Classes="sectionTitle" />
          <TextBox x:Name="Identity" Watermark="身份，例如 姓名 &lt;email@example.com&gt;" />
          <TextBox x:Name="Passphrase" PasswordChar="●" Watermark="设置私钥保护口令" />
          <TextBox x:Name="ConfirmPassphrase" PasswordChar="●" Watermark="再次输入口令" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="密钥参数" Classes="sectionTitle" />
          <Grid ColumnDefinitions="160,220" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <TextBlock Text="RSA 位数" Classes="fieldLabel" />
            <NumericUpDown x:Name="KeyBits" Grid.Column="1" Minimum="2048" Maximum="4096" Increment="1024" Value="3072" />
            <TextBlock Grid.Row="1" Text="有效天数（0 为永久）" Classes="fieldLabel" />
            <NumericUpDown x:Name="ValidDays" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="36500" Increment="1" Value="365" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="GenerateButton" Content="生成密钥对" Classes="primary" Click="Generate" />
            <ProgressBar x:Name="Progress" IsVisible="False" IsIndeterminate="True"
                         Width="220" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="生成结果" Classes="sectionTitle" />
          <TextBlock x:Name="Fingerprint" Classes="muted" />
          <TextBox x:Name="PublicKey" Height="150" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" Watermark="生成后的公钥" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExportPublic" Content="导出公钥" IsEnabled="False" Click="SavePublic" />
            <Button x:Name="ExportSecret" Content="导出私钥" IsEnabled="False" Click="SaveSecret" />
          </StackPanel>
          <TextBlock Text="生成成功后自动保存到密钥库，重启可继续使用。请成套备份数据库与保护密钥文件。"
                     Classes="caption" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="Status" Classes="status" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
