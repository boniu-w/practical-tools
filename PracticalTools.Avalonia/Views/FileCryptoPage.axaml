<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalTools.Desktop.Views.FileCryptoPage">
  <ScrollViewer>
    <StackPanel x:Name="Form" Margin="16" Spacing="12">
      <TextBlock x:Name="Heading" Text="使用公钥加密文件" FontSize="22" />
      <TextBlock Text="输入文件" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="InputPath" Watermark="选择需要处理的文件" />
        <Button Grid.Column="1" Content="选择文件" Click="SelectInput" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="KeyLabel" Text="ASCII 公钥" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="导入密钥文件" Click="ImportKey" />
      </Grid>
      <TextBox x:Name="KeyText" AcceptsReturn="True" Height="170" TextWrapping="Wrap"
               Watermark="粘贴 ASCII armored 密钥，或导入 .asc 文件" />
      <TextBox x:Name="Passphrase" IsVisible="False" PasswordChar="●" Watermark="私钥口令" />
      <TextBlock Text="输出文件（请选择新文件名）" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="OutputPath" Watermark="选择输出路径" />
        <Button Grid.Column="1" Content="保存到…" Click="SelectOutput" />
      </Grid>
      <Button x:Name="RunButton" Content="开始加密" Classes="accent" Click="Run" />
      <ProgressBar x:Name="Progress" IsIndeterminate="True" IsVisible="False" />
      <TextBlock x:Name="Status" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
