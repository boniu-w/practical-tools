<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalTools.Desktop.Views.FolderCryptoPage">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="16" MaxWidth="960" HorizontalAlignment="Center">
      <StackPanel Spacing="6">
        <TextBlock x:Name="Heading" Text="打包并加密文件夹" Classes="pageTitle" />
        <TextBlock Text="保留相对目录结构和空目录。输出必须是新名称；不覆盖、合并或修改源数据。" Classes="muted" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="密钥" Classes="sectionTitle" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="LibraryKeys" HorizontalAlignment="Stretch" PlaceholderText="从密钥库选择一个密钥" />
            <Button Grid.Column="1" Content="刷新密钥" Click="RefreshKeys" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="目录" Classes="sectionTitle" />
          <StackPanel x:Name="Inputs" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="InputPath" Watermark="输入目录" />
              <Button Grid.Column="1" Content="选择输入" Click="PickInput" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="OutputPath" Watermark="完整的新输出路径" />
              <Button Grid.Column="1" Content="保存到…" Click="PickOutput" />
            </Grid>
            <Button x:Name="RunButton" Content="打包并加密" Classes="primary" Click="Run" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="Cancel" />
            <ProgressBar x:Name="Progress" IsVisible="False" IsIndeterminate="True"
                         Width="220" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="默认最多 100000 个归档条目，展开数据与明文 ZIP 各限 20 GiB。链接、特殊文件及不可移植/冲突名称会拒绝整个操作。"
                     Classes="caption" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="Status" Classes="status" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
