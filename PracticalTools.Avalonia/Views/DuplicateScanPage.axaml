<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalTools.Desktop.Views.DuplicateScanPage">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="16">
      <StackPanel Spacing="6">
        <TextBlock Text="重复文件扫描" Classes="pageTitle" />
        <TextBlock Text="按大小和 SHA-256 比较内容，不仅比较名称。扫描完成后自动保存记录。" Classes="muted" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel x:Name="Inputs" Spacing="12">
          <TextBlock Text="扫描范围" Classes="sectionTitle" />
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
            <TextBlock Text="目录" VerticalAlignment="Center" />
            <TextBox x:Name="Roots" Grid.Column="1" Grid.ColumnSpan="2" AcceptsReturn="True" Height="70"
                     Watermark="每行一个目录，可分次添加" />
            <Button Grid.Column="3" Content="添加文件夹" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch" ToolTip.Tip="可一次选择多个文件夹" Click="PickFolders" />
            <TextBlock Grid.Row="1" Text="扩展名" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.Column="1" x:Name="ExtensionField">
              <Button x:Name="OpenExtensions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="选择扫描扩展名" Click="OpenExtensionList">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="ExtensionHint" Text="全部类型" Classes="muted" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="▾" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <ItemsControl x:Name="ExtensionTags" PointerPressed="ExtensionTagsPressed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,2,32,2">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="2" Padding="6,2,1,2" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        <Button Content="×" Click="RemoveExtension" Tag="{Binding}" VerticalAlignment="Top"
                                ToolTip.Tip="移除此扩展名" AutomationProperties.Name="{Binding StringFormat='移除 {0}'}"
                                MinWidth="20" MinHeight="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Popup x:Name="ExtensionPopup" PlacementTarget="{Binding #ExtensionField}" Placement="Bottom"
                     IsLightDismissEnabled="True">
                <Border Width="{Binding #ExtensionField.Bounds.Width}" Padding="10" CornerRadius="6"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                      <TextBox x:Name="CustomExtensions" Watermark="自定义扩展名，如 .log" KeyDown="CustomExtensionKeyDown" />
                      <Button x:Name="AddExtensionButton" Grid.Column="1" Content="添加" Click="AddCustomExtensions" />
                    </Grid>
                    <TextBlock x:Name="ExtensionError" IsVisible="False" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="220"><WrapPanel x:Name="ExtensionOptions" /></ScrollViewer>
                    <Button x:Name="ClearExtensionsButton" Content="清除所选" HorizontalAlignment="Right" IsEnabled="False" Click="ClearExtensions" />
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
            <CheckBox x:Name="ExcludeExtensions" Grid.Row="1" Grid.Column="2" Content="排除所选"
                      VerticalAlignment="Center" ToolTip.Tip="扫描时跳过选中的扩展名" />
            <Button x:Name="ScanButton" Grid.Row="1" Grid.Column="3" Content="开始扫描" Classes="primary"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Click="Start" />
          </Grid>
          <ProgressBar x:Name="Progress" IsVisible="False" IsIndeterminate="True" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="CancelButton" Content="取消扫描" IsEnabled="False" Click="Cancel" />
        <TextBlock x:Name="Status" Classes="status" VerticalAlignment="Center" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel x:Name="Actions" Spacing="12" IsEnabled="False">
            <TextBlock Text="扫描结果" Classes="sectionTitle" />
            <TextBox x:Name="Search" Watermark="筛选文件名或路径" TextChanged="Filter" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SuggestButton" Content="智能选择（每组保留一份）" Click="Suggest" />
              <ComboBox x:Name="RemovalMode" SelectedIndex="0">
                <ComboBoxItem x:Name="RecycleChoice" Content="移入 Windows 回收站" />
                <ComboBoxItem Content="永久删除（不可恢复）" />
              </ComboBox>
              <Button x:Name="RemoveButton" Content="移除所选…" Classes="danger" Click="Remove" />
            </StackPanel>
          </StackPanel>
          <Grid>
            <DataGrid x:Name="Results" Height="280" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="重复组" Binding="{Binding Group}" Width="115" />
                <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="170" />
                <DataGridTextColumn Header="字节数" Binding="{Binding Length}" Width="90" />
                <DataGridTextColumn Header="完整路径" Binding="{Binding FilePath}" Width="360" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyResults" Spacing="6" HorizontalAlignment="Center"
                        VerticalAlignment="Center" IsHitTestVisible="False">
              <Path Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center"
                    Fill="{DynamicResource TextMutedBrush}"
                    Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5A6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5S14 7.01 14 9.5S11.99 14 9.5 14z" />
              <TextBlock x:Name="EmptyResultsTitle" Text="还没有扫描结果" Classes="emptyTitle" />
              <TextBlock x:Name="EmptyResultsHint" Text="设置目录和后缀后开始扫描。" Classes="emptyHint" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="4" IsVisible="{Binding #Results.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="所选文件的完整路径" Classes="caption" />
            <SelectableTextBlock Text="{Binding #Results.SelectedItem.FilePath}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock x:Name="Warnings" Classes="caption" />
        </StackPanel>
      </Border>

      <TextBlock Text="支持多选。移除前将显示完整路径并再次检查文件与保留副本；每组至少保留一份。非 Windows 暂未接入系统回收站，永久删除需明确确认。"
                 Classes="caption" />

      <Expander Header="扫描记录（最近 500 条，只读，不用于删除）">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <Button x:Name="HistoryButton" Content="加载记录" Click="LoadHistory" />
          <DataGrid x:Name="History" Height="230" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="170" />
              <DataGridTextColumn Header="原路径" Binding="{Binding FilePath}" Width="360" />
              <DataGridTextColumn Header="记录时间" Binding="{Binding ScanTime}" Width="170" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
