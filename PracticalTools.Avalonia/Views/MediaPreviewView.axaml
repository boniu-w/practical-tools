<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalTools.Desktop.Views.MediaPreviewView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
    <StackPanel Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="PlayButton" Content="播放 / 继续" Click="Play" />
        <Button x:Name="PauseButton" Content="暂停" Click="Pause" />
        <Button x:Name="StopButton" Content="停止" Click="Stop" />
        <TextBlock Text="音量" VerticalAlignment="Center" />
        <Slider x:Name="Volume" Minimum="0" Maximum="100" Value="50" Width="120" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Slider x:Name="SeekPosition" Minimum="0" Maximum="100" Value="0" />
        <Button Grid.Column="1" x:Name="SeekButton" Content="跳转到所选位置" Click="Seek" />
      </Grid>
      <CheckBox x:Name="DisableHardwareDecoding" Content="禁用硬件加速（兼容模式；切换后需重新播放）" IsChecked="False" />
      <ProgressBar x:Name="PlaybackProgress" Minimum="0" Maximum="100" />
    </StackPanel>
    <TextBlock Grid.Row="1" x:Name="PlaybackStatus" TextWrapping="Wrap" />
    <ContentControl Grid.Row="2" x:Name="VideoHost" MinHeight="100" />
  </Grid>
</UserControl>
