<UserControl x:Class="PracticalTools.Views.GenerateKeyPair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:local="clr-namespace:PracticalTools.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:util="clr-namespace:PracticalTools.util">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <CheckBox
            Visibility="Hidden" />
            <Grid>
                <!-- Padding="8,8,40,8" -->
                <TextBox materialDesign:HintAssist.Hint="邮箱"
                     Text="{Binding EmailText}"
                     IsReadOnly="False"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </Grid>
            <TextBox x:Name="SelectKeyt"
                 IsReadOnly="False"
                 Text="{Binding PassphraseText}"
            materialDesign:HintAssist.Hint="密码"
            Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <Grid
            Width="Auto"
            Margin="10">
                <Button
                HorizontalAlignment="Left"
                materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                materialDesign:ButtonProgressAssist.Value="{Binding DismissButtonProgress}"
                Click="GeneratreKeyPairStr"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Visibility="{Binding ShowDismissButton, Converter={x:Static util:MyBooleanToVisibilityConverter.CollapsedInstance}}">
                    <StackPanel
                    Orientation="Horizontal">
                        <TextBlock x:Name="ButtonTextBlockKeyPair" Text="开始生成密钥对" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
