<UserControl x:Class="PracticalTools.Views.GenerateKeyPair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:local="clr-namespace:PracticalTools.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:util="clr-namespace:PracticalTools.util">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <CheckBox
            Visibility="Hidden" />
            <Grid>
                <!-- Padding="8,8,40,8" -->
                <TextBox materialDesign:HintAssist.Hint="邮箱"
                     Text="{Binding EmailText}"
                     IsReadOnly="False"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </Grid>
            <Grid>
                <PasswordBox x:Name="SelectKeytPassword"
                         materialDesign:HintAssist.Hint="密码"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         PasswordChanged="SelectKeyt_PasswordChanged" />
                <TextBox x:Name="SelectKeytText"
                     Text="{Binding PassphraseText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="密码"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Visibility="Collapsed" />
                <Button x:Name="TogglePasswordVisibility"
                    Style="{StaticResource MaterialDesignIconButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="36" Height="36"
                    Margin="0,0,4,0"
                    Click="TogglePasswordVisibility_Click"
                    ToolTip="显示/隐藏密码">
                    <materialDesign:PackIcon x:Name="EyeIcon" Kind="Eye" />
                </Button>
            </Grid>

            <Grid
            Width="Auto"
            Margin="10">
                <Button
                HorizontalAlignment="Left"
                materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                materialDesign:ButtonProgressAssist.Value="{Binding DismissButtonProgress}"
                Click="GeneratreKeyPairStr"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Visibility="{Binding ShowDismissButton, Converter={x:Static util:MyBooleanToVisibilityConverter.CollapsedInstance}}">
                    <StackPanel
                    Orientation="Horizontal">
                        <TextBlock x:Name="ButtonTextBlockKeyPair" Text="开始生成密钥对" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
