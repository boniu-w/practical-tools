<UserControl x:Class="PracticalTools.Views.GpgUniversal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PracticalTools.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../ResourceDictionary/CommonStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource RightGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="196*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!--页眉-->
        <Grid Grid.Row="0">
            <Border />
        </Grid>

        <!--正文-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60*" />
                <RowDefinition Height="40*" />
            </Grid.RowDefinitions>

            <!--标题-->
            <Grid Grid.Row="0">
                <TabControl>
                    <TabItem Header="我要加密" Background="Aqua">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,4">
                                <RadioButton x:Name="EncryptFileRadio"
                                             Content="加密文件"
                                             GroupName="EncryptMode"
                                             IsChecked="True"
                                             Style="{StaticResource MaterialDesignRadioButton}"
                                             VerticalAlignment="Center"
                                             Checked="EncryptMode_Checked" />
                                <RadioButton x:Name="EncryptFolderRadio"
                                             Content="加密文件夹"
                                             GroupName="EncryptMode"
                                             Style="{StaticResource MaterialDesignRadioButton}"
                                             VerticalAlignment="Center"
                                             Margin="16,0,0,0"
                                             Checked="EncryptMode_Checked" />
                            </StackPanel>
                            <local:EncryptionPage x:Name="FileEncryptPage" Grid.Row="1" />
                            <local:EncryptionFolderPage x:Name="FolderEncryptPage" Grid.Row="1" Visibility="Collapsed" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="我要解密" Background="#FF6A6A">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,4">
                                <RadioButton x:Name="DecryptFileRadio"
                                             Content="解密文件"
                                             GroupName="DecryptMode"
                                             IsChecked="True"
                                             Style="{StaticResource MaterialDesignRadioButton}"
                                             VerticalAlignment="Center"
                                             Checked="DecryptMode_Checked" />
                                <RadioButton x:Name="DecryptFolderRadio"
                                             Content="解密文件夹"
                                             GroupName="DecryptMode"
                                             Style="{StaticResource MaterialDesignRadioButton}"
                                             VerticalAlignment="Center"
                                             Margin="16,0,0,0"
                                             Checked="DecryptMode_Checked" />
                            </StackPanel>
                            <local:DencryptionPage x:Name="FileDecryptPage" Grid.Row="1" />
                            <local:DencryptionFolderPage x:Name="FolderDecryptPage" Grid.Row="1" Visibility="Collapsed" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="我要生成一个密钥对" Background="Chartreuse">
                        <local:GenerateKeyPair />
                    </TabItem>
                </TabControl>
            </Grid>

            <!--表格-->
            <Grid Grid.Row="1">
                <Grid>
                    <local:Message />
                </Grid>

                <Grid>
                    <local:GpgFileDataGrid></local:GpgFileDataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!--页脚-->
        <Grid Grid.Row="2">
            <Border />
        </Grid>
    </Grid>
</UserControl>