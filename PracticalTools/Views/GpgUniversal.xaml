<UserControl x:Class="PracticalTools.Views.GpgUniversal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PracticalTools.Views"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="196*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!--页眉-->
        <Grid Grid.Row="0">
            <Border/>
        </Grid>

        <!--正文-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50*" />
                <RowDefinition Height="50*" />
            </Grid.RowDefinitions>

            <!--标题-->
            <Grid Grid.Row="0">
                <TabControl>
                    <TabItem Header="我要加密">

                    </TabItem>

                    <TabItem Header="我要解密">

                    </TabItem>

                    <TabItem Header="我要生成一个密钥对">

                    </TabItem>
                </TabControl>
            </Grid>

            <!--表格-->
            <Grid Grid.Row="1">
                <Grid>
                    <local:Message />
                </Grid>

                <Grid>
                    <local:GpgFileDataGrid></local:GpgFileDataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!--页脚-->
        <Grid Grid.Row="2">
            <Border />
        </Grid>
    </Grid>
</UserControl>