<UserControl x:Class="PracticalTools.Views.DecryptionPreviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding GpgFileSelectedOne, StringFormat=当前密钥：{0}}"
                   Foreground="#546E7A" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="EncryptedPathTextBox" IsReadOnly="True"
                     materialDesign:HintAssist.Hint="选择要预览的 .gpg 文件（在本页临时解密）"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="8" />
            <Button x:Name="SelectFileButton" Grid.Column="1" Content="选择文件"
                    Margin="6,0,0,0" Click="SelectFile_Click" Style="{StaticResource MaterialDesignFlatButton}" />
            <Button x:Name="PreviewButton" Grid.Column="2" Content="查看加密文件"
                    Margin="6,0,0,0" Click="Preview_Click" Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button Grid.Column="3" Content="关闭预览" Margin="6,0,0,0"
                    Click="ClosePreview_Click" Style="{StaticResource MaterialDesignFlatButton}" />
            <Button x:Name="ExpandButton" Grid.Column="4" Content="放大" Margin="6,0,0,0"
                    Click="Expand_Click" Style="{StaticResource MaterialDesignFlatButton}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,4">
            <ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="在下方勾选一个带私钥的密钥，再选择文件预览。支持文本、图片、PDF、DOCX、XLSX 和常见音视频。"
                       Foreground="#546E7A" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#DCE2E7" BorderThickness="1" Background="White">
            <Grid>
                <TextBlock x:Name="EmptyHint" Text="文件内容将在这里显示。关闭预览或离开本页时，清理临时解密副本。"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="16" Foreground="#78909C" />
                <Grid x:Name="BrowserHost" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
