<UserControl x:Class="PracticalTools.Views.GpgTabItemHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PracticalTools.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

    <!-- 重写TabItem.Header，嵌套布局控件作为消息显示区 -->

    <!-- 使用StackPanel实现横向布局：图标 + 消息文本 + 状态提示 -->
    <StackPanel Orientation="Horizontal" Height="30" VerticalAlignment="Center" Margin="5,0"
                MouseEnter="TabHeader_OnMouseEnter"
                MouseLeave="TabHeader_OnMouseLeave">
        <!-- 消息图标（可选，增强视觉效果） -->
        <materialDesign:PackIcon
            Kind="Information"
            Width="16"
            Height="16"
            Foreground="#2F80ED"
            VerticalAlignment="Center" />
        <!-- 消息文本（命名为msgText，方便后台代码更新） -->
        <TextBlock x:Name="TbMessageHeader"
                   Text="当前无新消息"
                   Foreground="#333333"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0" />
        <!-- 未读消息红点（可选，用于提醒） -->
        <Ellipse x:Name="EllipseUnreadTip"
                 Width="8" Height="8"
                 Fill="#FF3030"
                 Visibility="Visible"
                 VerticalAlignment="Center"
                 Margin="10" />
    </StackPanel>
</UserControl>