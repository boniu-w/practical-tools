<UserControl x:Class="PracticalTools.Views.GpgFileDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:PracticalTools.util">

    <UserControl.Resources>
        <ResourceDictionary>
            <util:SecondsToDurationConverter x:Key="SecondsToDurationConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="6,4" Background="#F5F5F5"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding IsGpgAllSelected}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          VerticalAlignment="Center"
                          Content="全选" />
                <Button Content="删除选中"
                        Command="{Binding DeleteSelectedGpgFilesCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="8,3"
                        FontSize="12"
                        Foreground="Red"
                        Margin="12,0,0,0" />
                <Button Content="导出选中的公钥"
                        Command="{Binding ExportSelectedGpgFilesCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="8,3"
                        FontSize="12"
                        Foreground="#1E90C0"
                        Margin="6,0,0,0" />
                <Button Content="导入他人公钥"
                        Command="{Binding ImportGpgFilesCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="8,3"
                        FontSize="12"
                        Foreground="#2E7D32"
                        Margin="6,0,0,0" />
                <Button Content="备份选中"
                        Command="{Binding BackupSelectedGpgFilesCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="8,3"
                        FontSize="12"
                        Foreground="#6A1B9A"
                        Margin="12,0,0,0" />
                <Button Content="全部备份"
                        Command="{Binding BackupAllGpgFilesCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="8,3"
                        FontSize="12"
                        Foreground="#6A1B9A"
                        Margin="6,0,0,0" />
                <Button Content="恢复备份"
                        Command="{Binding RestoreGpgBackupCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="8,3"
                        FontSize="12"
                        Foreground="#6A1B9A"
                        Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Background="White" -->
        <DataGrid x:Name="GpgDataGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding GpgFileWrapperList}"
                  BorderBrush="#FFFAF0"
                  BorderThickness="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  SelectionMode="Extended"
                  CellEditEnding="GpgDataGrid_CellEditEnding">

            <DataGrid.Resources>
                <!-- 选中行背景色：Material Design 风格的淡色 -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="#1E90C0E0" />
                <!-- 选中行（失去焦点时）背景色 -->
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="#1E90C0E0" />
                <!-- 选中行文字颜色不变 -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="{StaticResource MaterialDesignBody}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="{StaticResource MaterialDesignBody}" />
            </DataGrid.Resources>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <!-- 导入的密钥行底色区分 -->
                        <DataTrigger Binding="{Binding GpgFile.IsImported}" Value="True">
                            <Setter Property="Background" Value="#FFF8E1" />
                        </DataTrigger>
                        <!-- 鼠标悬停效果 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F8FF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <!-- 去掉单元格焦点虚线框 -->
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

            <!-- ✅ CheckBox 列：TemplateColumn（关键） -->
            <DataGridTemplateColumn Width="1*" Header="">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Padding="0"
                                  Focusable="False" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- 文本列：完全不用管 CheckBox 了 -->
            <DataGridTextColumn Width="2*" IsReadOnly="True" Header="身份"
                                Binding="{Binding GpgFile.Identity}" />

            <DataGridTextColumn Width="2*" IsReadOnly="True" Header="别名"
                                Binding="{Binding GpgFile.IdentityName}" />

            <DataGridTextColumn Width="2*" IsReadOnly="True" Header="有效期开始于"
                                Binding="{Binding Path=GpgFile.ValidDurationBeginsOn,
                                                      StringFormat=HH:mm:ss yyyy-MM-dd}" />

            <DataGridTextColumn Width="2*" IsReadOnly="True" Header="有效期截至于"
                                Binding="{Binding Path=GpgFile.ValidDurationEndsOn,
                                                      StringFormat=HH:mm:ss yyyy-MM-dd}" />

            <DataGridTextColumn Width="2*" IsReadOnly="True" Header="密钥对有效时长"
                                Binding="{Binding Path=GpgFile.ValidDurationSeconds,
                                                      Converter={StaticResource SecondsToDurationConverter}}" />

            <DataGridTextColumn Width="2*" IsReadOnly="True" Header="私钥文件名"
                                Binding="{Binding GpgFile.FileNamePrivate}" />

            <DataGridTextColumn Width="2*" IsReadOnly="True" Header="公钥文件名"
                                Binding="{Binding GpgFile.FileNamePublic}" />

            <!--<DataGridTextColumn Width="3*" IsReadOnly="True" Header="创建时间"
                                Binding="{Binding GpgFile.FileCreateTime,
                                                      StringFormat=HH:mm yyyy-MM-dd}" />-->

            <!--<DataGridTextColumn Width="2*" Header="说明"
                                Binding="{Binding GpgFile.Description, UpdateSourceTrigger=LostFocus}" />-->

            <!-- ✅ 操作列 -->
            <DataGridTemplateColumn Width="1.2*" Header="操作">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Content="操作"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="6,2"
                                FontSize="12"
                                Click="OnOperationClick"
                                Tag="{Binding}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="查看" Click="OnViewClick" />
                                    <MenuItem Header="修改" Click="OnEditClick" />
                                    <Separator />
                                    <MenuItem Header="删除" Foreground="Red" Click="OnDeleteClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

        </DataGrid.Columns>
    </DataGrid>
    </Grid>
</UserControl>