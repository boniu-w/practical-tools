<Window x:Class="PracticalTools.Views.GpgDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:PracticalTools.util"
        Title="密钥详情" Width="560" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Window.Resources>
        <util:SecondsToDurationConverter x:Key="SecondsToDurationConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本信息" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#1565C0" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="身份:" Grid.Row="0" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.Identity}" Grid.Row="0" Grid.Column="1" Margin="0,3" />
                    <TextBlock Text="别名:" Grid.Row="1" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.IdentityName}" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                    <TextBlock Text="密钥长度:" Grid.Row="2" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.KeySize, StringFormat={}{0} bit}" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                    <TextBlock Text="类别:" Grid.Row="3" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.Type}" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                    <TextBlock Text="说明:" Grid.Row="4" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.Description}" Grid.Row="4" Grid.Column="1" Margin="0,3" TextWrapping="Wrap" />
                </Grid>
                <Separator Margin="0,4,0,10" />
                <TextBlock Text="有效期" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#1565C0" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="开始于:" Grid.Row="0" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.ValidDurationBeginsOn, StringFormat=yyyy-MM-dd HH:mm:ss}"
                               Grid.Row="0" Grid.Column="1" Margin="0,3" />
                    <TextBlock Text="截至于:" Grid.Row="1" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.ValidDurationEndsOn, StringFormat=yyyy-MM-dd HH:mm:ss}"
                               Grid.Row="1" Grid.Column="1" Margin="0,3" />
                    <TextBlock Text="有效时长:" Grid.Row="2" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.ValidDurationSeconds, Converter={StaticResource SecondsToDurationConverter}}"
                               Grid.Row="2" Grid.Column="1" Margin="0,3" />
                </Grid>
                <Separator Margin="0,4,0,10" />
                <TextBlock Text="文件信息" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#1565C0" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="公钥文件名:" Grid.Row="0" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.FileNamePublic}" Grid.Row="0" Grid.Column="1" Margin="0,3" TextWrapping="Wrap" />
                    <TextBlock Text="私钥文件名:" Grid.Row="1" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.FileNamePrivate}" Grid.Row="1" Grid.Column="1" Margin="0,3" TextWrapping="Wrap" />
                    <TextBlock Text="公钥MD5:" Grid.Row="2" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.Md5ValuePublic}" Grid.Row="2" Grid.Column="1" Margin="0,3"
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Text="私钥MD5:" Grid.Row="3" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.Md5ValuePrivate}" Grid.Row="3" Grid.Column="1" Margin="0,3"
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Text="创建时间:" Grid.Row="4" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.FileCreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                               Grid.Row="4" Grid.Column="1" Margin="0,3" />
                    <TextBlock Text="更新时间:" Grid.Row="5" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.UpdateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                               Grid.Row="5" Grid.Column="1" Margin="0,3" />
                </Grid>
                <Separator Margin="0,4,0,10" />
                <TextBlock Text="签名" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#1565C0" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="公钥签名:" Grid.Row="0" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.SignaturePublic}" Grid.Row="0" Grid.Column="1" Margin="0,3"
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                    <TextBlock Text="私钥签名:" Grid.Row="1" Grid.Column="0" Foreground="Gray" Margin="0,3" />
                    <TextBlock Text="{Binding GpgFile.SignaturePrivate}" Grid.Row="1" Grid.Column="1" Margin="0,3"
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="关闭" Width="80" Height="32"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnCloseClick" />
    </Grid>
</Window>