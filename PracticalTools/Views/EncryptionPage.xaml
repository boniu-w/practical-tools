<UserControl x:Class="PracticalTools.Views.EncryptionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:PracticalTools.Views"
             xmlns:util="clr-namespace:PracticalTools.util"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="root">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- <util:MyBooleanToVisibilityConverter x:Key="CollapsedInstance"></util:MyBooleanToVisibilityConverter> -->
            <!-- <util:MyBooleanToVisibilityConverter x:Key="NotCollapsedInstance"></util:MyBooleanToVisibilityConverter> -->
        </ResourceDictionary>

    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <CheckBox
                Visibility="Hidden" />
            <Grid>
                <!-- Padding="8,8,40,8" -->
                <TextBox materialDesign:HintAssist.Hint="点击右侧的向上箭头选择一个文件"
                         Text="{Binding SelectedFilePath}"
                         IsReadOnly="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <Button Style="{StaticResource MaterialDesignIconButton}"
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        Click="SelectFile_Click">
                    <materialDesign:PackIcon Kind="Upload" />
                </Button>
            </Grid>
            <TextBox x:Name="SelectKeyt"
                     IsReadOnly="True"
                     Text="{Binding DataContext.GpgFileSelectedOne, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                materialDesign:HintAssist.Hint="在下方选择一个密钥, 只能选一个"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" />

            <Grid
                Width="Auto"
                Margin="10">
                <StackPanel>
                    <Button
                        HorizontalAlignment="Left"
                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                        materialDesign:ButtonProgressAssist.Value="{Binding DismissButtonProgress}"
                        Click="EncryptFile"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding ShowDismissButton, Converter={x:Static util:MyBooleanToVisibilityConverter.CollapsedInstance}}">
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock x:Name="ButtonTextBlock" Text="开始加密" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="OutputPathText"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#2E7D32"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>