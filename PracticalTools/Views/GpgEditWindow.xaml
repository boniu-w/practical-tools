<Window x:Class="PracticalTools.Views.GpgEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="修改密钥" Width="500" Height="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="可修改字段" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Foreground="#1565C0" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="说明:" Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Top" Foreground="Gray" Margin="0,8,0,0" />
                <TextBox x:Name="TxtDescription" Grid.Row="0" Grid.Column="1" Margin="0,3"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"
                         materialDesign:HintAssist.Hint="备注说明（可选）"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10" />
            </Grid>

            <TextBlock Text="只读信息" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="#888" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="身份:" Grid.Row="0" Grid.Column="0" Foreground="#AAA" Margin="0,3" FontSize="11" />
                <TextBlock Text="{Binding GpgFile.Identity}" Grid.Row="0" Grid.Column="1"
                           Margin="0,3" FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />

                <TextBlock Text="别名:" Grid.Row="1" Grid.Column="0" Foreground="#AAA" Margin="0,3" FontSize="11" />
                <TextBlock Text="{Binding GpgFile.IdentityName}" Grid.Row="1" Grid.Column="1"
                           Margin="0,3" FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />

                <TextBlock Text="密码:" Grid.Row="2" Grid.Column="0" Foreground="#AAA" Margin="0,3" FontSize="11" />
                <TextBlock Text="{Binding GpgFile.PassphraseDisplay}" Grid.Row="2" Grid.Column="1"
                           Margin="0,3" FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />

                <TextBlock Text="公钥文件:" Grid.Row="3" Grid.Column="0" Foreground="#AAA" Margin="0,3" FontSize="11" />
                <TextBlock Text="{Binding GpgFile.FileNamePublic}" Grid.Row="3" Grid.Column="1"
                           Margin="0,3" FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />

                <TextBlock Text="私钥文件:" Grid.Row="4" Grid.Column="0" Foreground="#AAA" Margin="0,3" FontSize="11" />
                <TextBlock Text="{Binding GpgFile.FileNamePrivate}" Grid.Row="4" Grid.Column="1"
                           Margin="0,3" FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />

                <TextBlock Text="创建时间:" Grid.Row="5" Grid.Column="0" Foreground="#AAA" Margin="0,3" FontSize="11" />
                <TextBlock Text="{Binding GpgFile.FileCreateTime, StringFormat=yyyy-MM-dd HH:mm}"
                           Grid.Row="5" Grid.Column="1" Margin="0,3" FontSize="11" Foreground="#AAA" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="80" Height="32" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignFlatButton}" Click="OnCancelClick" />
            <Button Content="保存" Width="80" Height="32"
                    Style="{StaticResource MaterialDesignRaisedButton}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>