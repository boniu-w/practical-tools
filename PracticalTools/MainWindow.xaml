<Window x:Class="PracticalTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:util="clr-namespace:PracticalTools.util;assembly=PracticalTools"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1090">
    <!-- <Window.DataContext> -->
    <!--     <vo:MainViewModel /> -->
    <!-- </Window.DataContext> -->
    <Window.Resources>
        <FrameworkElement x:Key="DataContextProxy" DataContext="{Binding}" />
    </Window.Resources>


    <!-- HorizontalAlignment="Stretch" 水平方向拉伸填充 -->
    <!-- VerticalAlignment="Stretch"   垂直方向拉伸填充 -->
    <TabControl
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        TabStripPlacement="Left"
        materialDesign:ColorZoneAssist.Foreground="#FF6A6A"
        materialDesign:ColorZoneAssist.Mode="Custom">
        <TabItem Header="重复文件">
            <Grid Background="#f2f3f8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="90*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="White" Margin="10,10,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150*" />
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0"
                             x:Name="TheFilePath"
                             BorderBrush="Red"
                             Background="#FFFAFA"
                             Margin="5" Padding="0"
                             materialDesign:HintAssist.Hint="文件路径">
                    </TextBox>
                    <Button Grid.Row="0" Grid.Column="1"
                            Background="#F8F8FF"
                            Content="选择文件夹" Click="PickFile"
                            Margin="5,0,0,0" Padding="0" />
                    <Button Grid.Row="0" Grid.Column="2"
                            Background="#F8F8FF"
                            Content="不选择文件夹" Click="UnPickFile"
                            Margin="5,0,0,0" Padding="0" />
                    <!-- <Button Grid.Row="0" Grid.Column="3" -->
                    <!--         Background="#F8F8FF" -->
                    <!--         Content="扫描种类" Click="UnPickFile" -->
                    <!--         Margin="5,0,0,0" Padding="0" /> -->
                    <Grid Grid.Row="0" Grid.Column="3">
                        <ComboBox x:Name="ScanType"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  materialDesign:ComboBoxAssist.MaxLength="2"
                                  materialDesign:HintAssist.Hint="扫描类型"
                                  materialDesign:HintAssist.HintOpacity=".26"
                                  IsEditable="False">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="图片类" />
                            <ComboBoxItem Content="视频类" />
                            <ComboBoxItem Content="音频类" />
                            <ComboBoxItem Content="文字类" />
                            <ComboBoxItem Content="无类型" />
                        </ComboBox>
                    </Grid>
                    <Button Grid.Row="0" Grid.Column="4"
                            Background="#F8F8FF"
                            Margin="5,0,0,0" Padding="0"
                            Content="开始扫描" Click="ScanTheFolder" />
                    <Button Grid.Row="0" Grid.Column="5"
                            Background="#F8F8FF"
                            Margin="5,0,0,0" Padding="0"
                            Content="停止扫描" Click="StopScanTheFolder" />
                </Grid>

                <Grid Grid.Row="1">
                    <TabControl>
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                <Setter Property="BorderBrush" Value="Aquamarine" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Background" Value="Aquamarine" />
                                <Setter Property="FontSize" Value="14" /> <!-- 默认字体大小 -->
                                <Setter Property="Foreground" Value="Black" /> <!-- 默认字体颜色 -->
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="DarkBlue" /> <!-- 选中时颜色 -->
                                        <Setter Property="FontSize" Value="16" /> <!-- 选中时字体大小 -->
                                        <Setter Property="Background" Value="Red" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="扫描结果">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10*" />
                                    <RowDefinition Height="90*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*" />
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0"
                                             x:Name="SearchText"
                                             BorderBrush="Red"
                                             Background="#FFFAFA"
                                             Margin="5" Padding="0"
                                             materialDesign:HintAssist.Hint="搜索">
                                    </TextBox>
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Background="#F8F8FF"
                                            Content="搜索" Click="SearchDuplicateFile"
                                            Margin="5,0,0,0" Padding="0" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Background="#F8F8FF"
                                            Content="不搜索" Click="NoSearchDuplicateFile"
                                            Margin="5,0,0,0" Padding="0" />
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          Background="White"
                                          Margin="10,10,5,0"
                                          ItemsSource="{Binding FileList}"
                                          Name="DuplicateFiles"
                                          BorderBrush="#FFFAF0"
                                          BorderThickness="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn IsReadOnly="False"
                                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGridCheckBoxColumn.Header>
                                                <Border Background="Transparent">
                                                    <CheckBox IsThreeState="True"
                                                              IsChecked="{Binding DataContext.IsAllSelected, Source={StaticResource DataContextProxy} ,Mode=TwoWay}" />
                                                </Border>
                                            </DataGridCheckBoxColumn.Header>
                                            <DataGridCheckBoxColumn.HeaderStyle>
                                                <Style TargetType="{x:Type DataGridColumnHeader}"
                                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                </Style>
                                            </DataGridCheckBoxColumn.HeaderStyle>
                                        </DataGridCheckBoxColumn>
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="文件名" Binding="{Binding Entry.FileName}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="hash值" Binding="{Binding Entry.HashValue}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="文件地址" Binding="{Binding Entry.FilePath}" />
                                        <DataGridTextColumn Width="*" IsReadOnly="True" Header="文件大小[k]" Binding="{Binding Entry.FileSize}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="文件创建时间" Binding="{Binding Entry.FileCreateTime}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="最后修改时间" Binding="{Binding Entry.FileLastedModifiedTime}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="扫描的文件夹" Binding="{Binding Entry.ScanDirectory}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="扫描时间" Binding="{Binding Entry.ScanTime}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="扫描历史">
                            <Grid>
                                <DataGrid Grid.Row="0"
                                          Background="White"
                                          Margin="10,10,5,0"
                                          ItemsSource="{Binding HistoryFileList}"
                                          Name="DuplicateFilesHistory"
                                          BorderBrush="#FFFAF0"
                                          BorderThickness="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="文件名" Binding="{Binding FileName}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="hash值" Binding="{Binding HashValue}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="文件地址" Binding="{Binding FilePath}" />
                                        <DataGridTextColumn Width="*" IsReadOnly="True" Header="文件大小[k]" Binding="{Binding FileSize}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="文件创建时间" Binding="{Binding FileCreateTime}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="最后修改时间" Binding="{Binding FileLastedModifiedTime}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="扫描的文件夹" Binding="{Binding ScanDirectory}" />
                                        <DataGridTextColumn Width="2*" IsReadOnly="True" Header="扫描时间" Binding="{Binding ScanTime}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="黑名单">
            <Grid Background="#f2f3f8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"></RowDefinition>
                    <RowDefinition Height="0.5*"></RowDefinition>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          Background="White" Margin="10,10,5,0"
                          Name="BlackL"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ItemsSource="{Binding Blacklists}">
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="平台名称(淘宝, 知乎, b站)" Binding="{Binding PlatformName}" />
                        <DataGridTextColumn IsReadOnly="True" Header="作者" Binding="{Binding Author}" />
                        <DataGridTextColumn IsReadOnly="True" Header="作品" Binding="{Binding Product}" />
                        <DataGridTextColumn IsReadOnly="True" Header="作品日期" Binding="{Binding WorksTime}" />
                        <DataGridTextColumn IsReadOnly="True" Header="原因" Binding="{Binding Reason}" />
                        <DataGridTextColumn IsReadOnly="True" Header="类型(电商, 视频网站, 知识网站)" Binding="{Binding WorksType}" />
                        <DataGridTextColumn IsReadOnly="True" Header="统一社会信用代码" Binding="{Binding UnifiedSocialCreditIdentifier}" />
                        <DataGridTextColumn IsReadOnly="True" Header="备注" Binding="{Binding Remarks}" />
                        <DataGridTextColumn IsReadOnly="True" Header="创建时间" Binding="{Binding CreateTime}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Background="White" Margin="10,10,5,0">
                    <Button Content="刷新" Command="{Binding RefreshCommand}" />
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="test">
            <Grid>
                <!-- <Button Click="SqliteTest" Content="Sqlite Test" /> -->
                <!-- <Button Click="List" Content="List" /> -->
                <!-- <Button Click="DeleteFiles" Content="DeleteFiles" /> -->
                <Button Click="GetSelectedAll" Content="GetSelectedAll" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>