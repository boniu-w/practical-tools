<Window x:Class="PracticalTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1090">
    <!-- <Window.DataContext> -->
    <!--     <vo:MainViewModel /> -->
    <!-- </Window.DataContext> -->

    <!-- HorizontalAlignment="Stretch" 水平方向拉伸填充 -->
    <!-- VerticalAlignment="Stretch"   垂直方向拉伸填充 -->
    <TabControl
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        TabStripPlacement="Left"
        materialDesign:ColorZoneAssist.Foreground="#FF6A6A"
        materialDesign:ColorZoneAssist.Mode="Custom">
        <TabItem Header="重复文件">
            <Grid Background="#f2f3f8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="90*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="White" Margin="10,10,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150*" />
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0"
                             x:Name="TheFilePath"
                             BorderBrush="Red"
                             Background="#FFFAFA"
                             Margin="5" Padding="0"
                             materialDesign:HintAssist.Hint="文件路径">
                    </TextBox>
                    <Button Grid.Row="0" Grid.Column="1"
                            Background="#F8F8FF"
                            Content="选择文件夹" Click="PickFile"
                            Margin="5,0,0,0"  Padding="0" />
                    <Button Grid.Row="0" Grid.Column="2"
                            Background="#F8F8FF"
                            Content="不选择文件夹" Click="UnPickFile"
                            Margin="5,0,0,0"  Padding="0" />
                    <Button Grid.Row="0" Grid.Column="3"
                            Background="#F8F8FF"
                            Margin="5,0,0,0" Padding="0"
                            Content="开始扫描" Click="ScanTheFolder">
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1" Background="White" Margin="10,10,5,0"
                          Name="DuplicateFiles"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ItemsSource="{Binding FileList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="文件名" Binding="{Binding FileName}" />
                        <DataGridTextColumn IsReadOnly="True" Header="文件地址" Binding="{Binding FilePath}" />
                        <DataGridTextColumn IsReadOnly="True" Header="文件大小" Binding="{Binding FileSize}" />
                        <DataGridTextColumn IsReadOnly="True" Header="时间" Binding="{Binding FileCreateTime}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="黑名单">
            <Grid Background="#f2f3f8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"></RowDefinition>
                    <RowDefinition Height="0.5*"></RowDefinition>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" Background="White" Margin="10,10,5,0"
                          Name="BlackL"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ItemsSource="{Binding Blacklists}">
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="平台名称(淘宝, 知乎, b站)" Binding="{Binding PlatformName}" />
                        <DataGridTextColumn IsReadOnly="True" Header="作者" Binding="{Binding Author}" />
                        <DataGridTextColumn IsReadOnly="True" Header="作品" Binding="{Binding Product}" />
                        <DataGridTextColumn IsReadOnly="True" Header="作品日期" Binding="{Binding WorksTime}" />
                        <DataGridTextColumn IsReadOnly="True" Header="原因" Binding="{Binding Reason}" />
                        <DataGridTextColumn IsReadOnly="True" Header="类型(电商, 视频网站, 知识网站)" Binding="{Binding WorksType}" />
                        <DataGridTextColumn IsReadOnly="True" Header="备注" Binding="{Binding Remarks}" />
                        <DataGridTextColumn IsReadOnly="True" Header="创建时间" Binding="{Binding CreateTime}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Background="White" Margin="10,10,5,0">
                    <Button Content="刷新" Command="{Binding RefreshCommand}" />
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="test">
            <Grid>
                <Button Click="SqliteTest" Content="Sqlite Test" />
                <!-- <Button Click="List" Content="List" /> -->
            </Grid>
        </TabItem>
    </TabControl>
</Window>