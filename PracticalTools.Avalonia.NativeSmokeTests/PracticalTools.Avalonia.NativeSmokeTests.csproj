<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The harness must carry the same Windows manifest as the real app; NativeControlHost
         cannot create its child HWND without the supportedOS list. -->
    <ApplicationManifest>../PracticalTools.Avalonia/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PracticalTools.Avalonia/PracticalTools.Avalonia.csproj" />
    <Compile Include="../PracticalTools.Core.Tests/MediaFixture.cs" Link="MediaFixture.cs" />
    <Compile Include="../PracticalTools.Core.Tests/ImageFixture.cs" Link="ImageFixture.cs" />
    <EmbeddedResource Include="../PracticalTools.Core.Tests/Fixtures/PreviewAac.aac" Link="Fixtures/PreviewAac.aac" LogicalName="PracticalTools.TestFixtures.PreviewAac.aac" />
    <EmbeddedResource Include="../PracticalTools.Core.Tests/Fixtures/PreviewWmv.wmv" Link="Fixtures/PreviewWmv.wmv" LogicalName="PracticalTools.TestFixtures.PreviewWmv.wmv" />
    <EmbeddedResource Include="../PracticalTools.Core.Tests/Fixtures/PreviewAvif.avif" Link="Fixtures/PreviewAvif.avif" LogicalName="PracticalTools.TestFixtures.PreviewAvif.avif" />
    <EmbeddedResource Include="../PracticalTools.Core.Tests/Fixtures/PreviewAnimatedGif.gif" Link="Fixtures/PreviewAnimatedGif.gif" LogicalName="PracticalTools.TestFixtures.PreviewAnimatedGif.gif" />
  </ItemGroup>
</Project>
